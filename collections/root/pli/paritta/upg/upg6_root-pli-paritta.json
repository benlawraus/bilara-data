{
  "upg6:0.1": "6. Caturārakkhā Bhāvanā",
  "upg6:1.1": "Buddhānussati, mettā ca, asubhaṁ, maraṇassati -",
  "upg6:1.2": "iti imā caturārakkhā bhikkhu bhāveyya sīlavā.",
  "upg6:2.1": "Anantavitthāraguṇaṁ guṇatonussaraṁ Muniṁ,",
  "upg6:2.2": "bhāveyya buddhimā bhikkhu Buddhānussati-m-ādito.",
  "upg6:3.1": "Buddhānussati",
  "upg6:4.1": "Savāsane kilese so eko sabbe nighātiya,",
  "upg6:4.2": "ahū susuddhasantāno pūjānaṁ ca sadāraho.",
  "upg6:5.1": "Sabbakālagate dhamme sabbe sammā sayaṁ Muni",
  "upg6:5.2": "sabbākārena bujjhitvā, eko sabbaññutaṁ gato.",
  "upg6:6.1": "Vipassanādi vijjāhi sīlādi caraṇehi ca,",
  "upg6:6.2": "susamiddhehi sampanno, gaganābhehi nāyako.",
  "upg6:7.1": "Sammāgato subhaṁ ṭhānaṁ amoghavacano ca so,",
  "upg6:7.2": "tividhassāpi lokassa ñātā niravasesato.",
  "upg6:8.1": "Anekehi guṇoghehi sabbasattuttamo ahū,",
  "upg6:8.2": "anekehi upāyehi naradamme damesi ca.",
  "upg6:9.1": "Eko sabbassa lokassa sabbamatthānusāsako,",
  "upg6:9.2": "bhāgya-issariyādīnaṁ guṇānaṁ paramo nidhī.",
  "upg6:10.1": "Paññāssa sabbadhammesu karuṇā sabbajantusu,",
  "upg6:10.2": "attatthānaṁ paratthānaṁ sādhikā guṇajeṭṭhikā.",
  "upg6:11.1": "Dayāya pāramī citvā paññāyattānam-uddharī,",
  "upg6:11.2": "uddharī sabbadhamme ca, dayāyaññe ca uddharī.",
  "upg6:12.1": "Dissamāno pi tāvassa rūpakāyo acintayo,",
  "upg6:12.2": "asādhāraṇañāṇaḍḍhe dhammakāye kathā va kā ti?",
  "upg6:13.1": "Mettabhāvanā",
  "upg6:14.1": "Attūpamāya sabbesaṁ sattānaṁ sukhakāmataṁ,",
  "upg6:14.2": "passitvā kamato mettaṁ sabbasattesu bhāvaye.",
  "upg6:15.1": "Sukhī bhaveyyaṁ niddukkho, ahaṁ niccaṁ, aham viya",
  "upg6:15.2": "hitā ca me sukhī hontu, majjhattā cātha verino.",
  "upg6:16.1": "Imamhi gāmakkhettamhi, sattā hontu sukhī sadā,",
  "upg6:16.2": "tato parañ-ca rajjesu, cakkavālesu jantuno.",
  "upg6:17.1": "Samantā cakkavālesu sattānantesu pāṇino,",
  "upg6:17.2": "sukhino puggalā bhūtā attabhāvagatā siyuṁ,",
  "upg6:18.1": "tathā itthī pumā ceva ariyā anariyā pi ca,",
  "upg6:18.2": "devā narā apāyaṭṭhā, tathā dasadisāsu cā ti.",
  "upg6:19.1": "Asubhasaññā",
  "upg6:20.1": "Aviññāṇasubhanibhaṁ saviññāṇasubhaṁ imaṁ,",
  "upg6:20.2": "kāyaṁ asubhato passaṁ, asubhaṁ bhāvaye yati.",
  "upg6:21.1": "Vaṇṇasaṇṭhānagandhehi āsayokāsato tathā,",
  "upg6:21.2": "paṭikkūlāni kāye me kuṇapāni dvisoḷasa.",
  "upg6:22.1": "Patitamhā pi kuṇapā, jegucchaṁ kāyanissitaṁ,",
  "upg6:22.2": "ādhāro hi ’suci tassa, kāye tu kuṇape ṭhitaṁ.",
  "upg6:23.1": "Mīlhe kimi va kāyoyaṁ asucimhi samuṭṭhito,",
  "upg6:23.2": "anto asucisampuṇṇo puṇṇavaccakuṭī viya.",
  "upg6:24.1": "Asucisandate niccaṁ yathā medakathālikā,",
  "upg6:24.2": "nānākimikulāvāso, pakkhacandanikā viya.",
  "upg6:25.1": "Gaṇḍabhūto, rogabhūto, vaṇabhūto, samussayo,",
  "upg6:25.2": "atekiccho ti jeguccho pabhinnakuṇapūpamo ti.",
  "upg6:26.1": "Maraṇānussati",
  "upg6:27.1": "Pavātadīpatulyāya, sāyusantatiyā khayaṁ,",
  "upg6:27.2": "parūpamāya sampassaṁ, bhāvaye maraṇassatiṁ.",
  "upg6:28.1": "Mahāsampattisampattā yathā sattā matā idha,",
  "upg6:28.2": "tathā ahaṁ marissāmi maranaṁ mama hessati.",
  "upg6:29.1": "Uppattiyā sahevedaṁ maraṇaṁ āgataṁ sadā,",
  "upg6:29.2": "maraṇatthāya okāsaṁ vadhako viya esati.",
  "upg6:30.1": "Īsakaṁ anivattaṁ taṁ satataṁ gamanussukaṁ,",
  "upg6:30.2": "jīvitaṁ udayā atthaṁ suriyo viya dhāvati.",
  "upg6:31.1": "Vijjububbula-ussāva, jalarājī parikkhayaṁ,",
  "upg6:31.2": "ghātako varipūtassa sabbatthā pi avāriyo.",
  "upg6:32.1": "Suyasatthāmapuññiddhī buddhivuddhī Jinadvayaṁ,",
  "upg6:32.2": "ghātesi maraṇaṁ khippaṁ, kā tu mādisake kathā?",
  "upg6:33.1": "Paccayānañ-ca vekalyā bāhirajjhattupaddavā,",
  "upg6:33.2": "marāmoraṁ nimesā pi maramāno anukkhaṇan-ti.",
  "upg6:34.1": "Aṭṭhasaṁvegavatthūni",
  "upg6:35.1": "Bhāvetvā caturārakkhā āvajjeyya anantaraṁ",
  "upg6:35.2": "mahāsaṁvegavatthūni, aṭṭha aṭṭhitavīriyo.",
  "upg6:36.1": "Jātijarāvyādhicutī apāyā,",
  "upg6:36.2": "atīta-appattakavaṭṭadukkhaṁ,",
  "upg6:36.3": "idāni āhāragaveṭṭhidukkhaṁ -",
  "upg6:36.4": "saṁvegavatthūni imāni aṭṭha.",
  "upg6:37.1": "Pāto ca sāyam-api ceva imaṁ vidhiñño,",
  "upg6:37.2": "āsevate satatamatta hitābhilāsi,",
  "upg6:37.3": "pappoti so ti vipulaṁ hata pāripantho,",
  "upg6:37.4": "seṭṭhaṁ sukhaṁ muni visiṭṭhamataṁ sukhena cā ti."
}