{
  "upg10:0.1": "10. Vaṭṭakaparittaṁ",
  "upg10:1.1": "",
  "upg10:2.1": "Pūrentaṁ Bodhisambhāre nibbattaṁ vaṭṭakajātiyaṁ,",
  "upg10:2.2": "yassa tejena dāvaggi Mahāsattaṁ vivajjayi.",
  "upg10:2.3": "Therassa Sāriputtassa Lokanāthena bhāsitaṁ,",
  "upg10:2.4": "Kappaṭṭhāyimahātejaṁ: parittaṁ taṁ bhaṇamahe.",
  "upg10:3.1": "",
  "upg10:4.1": "Atthi loke sīlaguṇo saccaṁ soceyyanuddayā,",
  "upg10:4.2": "tena saccena kāhāmi, saccakiriyam-uttamaṁ.",
  "upg10:5.1": "Āvajjetvā Dhammabalaṁ, saritvā pubbake Jine,",
  "upg10:5.2": "saccabalam-avassāya, saccakiriyam-akāsahaṁ:",
  "upg10:6.1": "“Santi pakkhā apatanā, santi pādā avañcanā,",
  "upg10:6.2": "Mātāpitā ca nikkhantā, Jātaveda, paṭikkama!”",
  "upg10:7.1": "Sahasaccakate mayhaṁ, mahāpajjalito sikhī",
  "upg10:7.2": "vajjesi soḷasakarīsāni, udakaṁ patvā yathā sikhī,",
  "upg10:7.3": "saccena me samo natthi, esā me saccapāramī!",
  "upg10:8.1": "Etena saccavajjena sotthi te hotu sabbadā!"
}