{
  "upg12:0.1": "12. Narasīhagāthā",
  "upg12:1.1": "Cakkavaraṅkitarattasupādo,",
  "upg12:1.2": "lakkhaṇamaṇḍita-āyatapaṇhī,",
  "upg12:1.3": "cāmarachattavibhūsitapādo,",
  "upg12:1.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:2.1": "Sakyakumāravaro sukhumālo,",
  "upg12:2.2": "lakkhaṇacittikapuṇṇasarīro,",
  "upg12:2.3": "lokahitāya gato naravīro,",
  "upg12:2.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:3.1": "Puṇṇasasaṅkanibho mukhavaṇṇo,",
  "upg12:3.2": "Devanarāna’ piyo naranāgo,",
  "upg12:3.3": "mattagajindavilāsitagāmī,",
  "upg12:3.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:4.1": "Khattiyasambhava-aggakulīno,",
  "upg12:4.2": "devamanussanamassitapādo,",
  "upg12:4.3": "sīlasamādhipatiṭṭhitacitto,",
  "upg12:4.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:5.1": "Āyatatuṅgasusaṇṭhitanāso,",
  "upg12:5.2": "gopakhumo abhinīlasunetto,",
  "upg12:5.3": "indadhanū-abhinīlabhamūko,",
  "upg12:5.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:6.1": "Vaṭṭasumaṭṭasusaṇṭhitagīvo,",
  "upg12:6.2": "sīhahanū migarājasarīro,",
  "upg12:6.3": "kañcanasucchavi-uttamavaṇṇo,",
  "upg12:6.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:7.1": "Siniddhasugambhiramañjusaghoso,",
  "upg12:7.2": "hiṅgulabandhusurattasujivho,",
  "upg12:7.3": "vīsativīsatisetasudanto,",
  "upg12:7.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:8.1": "Añjanavaṇṇasunīlasukeso,",
  "upg12:8.2": "kañcanapaṭṭavisuddhanalāṭo,",
  "upg12:8.3": "osadhipaṇḍarasuddhasu-uṇṇo,",
  "upg12:8.4": "esa hi tuyha’ pitā narasīho.",
  "upg12:9.1": "Gacchati nīlapathe viya cando,",
  "upg12:9.2": "tāragaṇāpariveṭhitarūpo,",
  "upg12:9.3": "sāvakamajjhagato Samaṇindo,",
  "upg12:9.4": "esa hi tuyha’ pitā narasīho ti."
}