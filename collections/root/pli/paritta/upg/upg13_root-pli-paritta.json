{
  "upg13:0.1": "13. Aṭṭhavīsati Paritta",
  "upg13:1.1": "Taṅhaṅkaro Mahāvīro, Medhaṅkaro Mahāyaso,",
  "upg13:1.2": "Saraṇaṅkaro Lokahito, Dīpaṅkaro Jutindharo.",
  "upg13:2.1": "Koṅḍañño Janapāmokkho, Maṅgalo Purisāsabho,",
  "upg13:2.2": "Sumano Sumano Dhīro, Revato Rativaḍḍhano.",
  "upg13:3.1": "Sobhito Guṇasampanno, Anomadassī Januttamo,",
  "upg13:3.2": "Padumo Lokapajjoto, Nārado Varasārathī.",
  "upg13:4.1": "Padumuttaro Sattasāro, Sumedho Aggapuggalo,",
  "upg13:4.2": "Sujāto Sabba Lokaggo, Piyadassī Narāsabho.",
  "upg13:5.1": "Atthadassī Kāruṅiko, Dhammadassī Tamonudo,",
  "upg13:5.2": "Siddhattho Asamo Loke, Tisso Varadasaṁvaro.",
  "upg13:6.1": "Phusso Varadasambuddho, Vipassī ca Anūpamo,",
  "upg13:6.2": "Sikhī Sabba Hito Satthā, Vessabhū Sukhadāyako.",
  "upg13:7.1": "Kakusandho Satthavāho, Koṅāgamano Raṅañjaho,",
  "upg13:7.2": "Kassapo Sirisampanno, Gotamo Sakya Puṅgavo.",
  "upg13:8.1": "Tesaṁ saccena sīlena, khantimettabalena ca.",
  "upg13:8.2": "te pi tvaṁ anurakkhantu, ārogyena sukhena cā ti.",
  "upg13:9.1": "Aṭṭhavīsati me Buddhā, puretvā dasapāramī,",
  "upg13:9.2": "Jetvā mārāri saṅgāmaṁ, Buddhattaṁ samupāgamuṁ,",
  "upg13:9.3": "Etena saccavajjena hotu te jayamaṅgalaṁ!"
}