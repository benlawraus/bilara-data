{
  "upg8:0.1": "8. Aṅgulimālaparittaṁ",
  "upg8:1.1": "Parittaṁ yaṁ bhaṇantassa, nisinnaṭṭhānadhovanaṁ",
  "upg8:1.2": "udakam-pi vināseti, sabbam-eva parissayaṁ,",
  "upg8:1.3": "“Sotthinā gabbhavuṭṭhānaṁ, yaṁ ca sādheti taṁ bhaṇe,”",
  "upg8:1.4": "Therass' Aṅgulimālassa, Lokanāthena bhāsitaṁ.",
  "upg8:2.1": "Kappaṭṭhāyimahātejaṁ, parittaṁ taṁ bhaṇāmahe:",
  "upg8:3.1": "REFERENCE mn86:15.8 TO mn86:15.8"
}