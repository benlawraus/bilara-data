{
  "mp1:0.1": "Mahāparittaṁ",
  "mp1:0.2": "",
  "mp1:1.1": "Namakkāraṁ",
  "mp1:2.1": "",
  "mp1:3.1": "Namo tassa Bhagavato Arahato Sammāsambuddhassa x 3",
  "mp1:4.1": "Saraṇagamanaṁ",
  "mp1:5.1": "REFERENCE kp1:2.1 TO kp1:4.3",
  "mp1:8.1": "Pañcasikkhāpadāni",
  "mp1:9.1": "Pāṇātipātā veramaṇīsikkhāpadaṁ samādiyāmi",
  "mp1:10.1": "Adinnādānā veramaṇīsikkhāpadaṁ samādiyāmi",
  "mp1:11.1": "Kāmesumicchācārā veramaṇīsikkhāpadaṁ samādiyāmi",
  "mp1:12.1": "Musāvādā veramaṇīsikkhāpadaṁ samādiyāmi",
  "mp1:13.1": "Surāmerayamajjapamādaṭṭhānā veramaṇīsikkhāpadaṁ samādiyāmi",
  "mp1:14.1": "",
  "mp1:15.1": "Ārādhanā",
  "mp1:16.1": "Vipattipaṭibāhāya, sabbasampattisiddhiyā,",
  "mp1:17.1": "sabbadukkhavināsāya: parittaṁ brūtha maṅgalaṁ.",
  "mp1:18.1": "Vipattipaṭibāhāya, sabbasampattisiddhiyā,",
  "mp1:19.1": "sabbabhayavināsāya: parittaṁ brūtha maṅgalaṁ.",
  "mp1:20.1": "Vipattipaṭibāhāya, sabbasampattisiddhiyā,",
  "mp1:21.1": "sabbarogavināsāya: parittaṁ brūtha maṅgalaṁ.",
  "mp1:22.1": "Devārādhanā",
  "mp1:23.1": "",
  "mp1:24.1": "Samantā cakkavāḷesu atrāgacchantu devatā",
  "mp1:25.1": "saddhammaṁ Munirājassa suṇantu saggamokkhadaṁ:",
  "mp1:26.1": "Parittassavaṇakālo ayaṁ bhadantā!",
  "mp1:27.1": "Parittassavaṇakālo ayaṁ bhadantā!",
  "mp1:28.1": "Parittassavaṇakālo ayaṁ bhadantā!"
}
