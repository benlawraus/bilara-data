{
  "mp2:0.1": "2. Tiratanaguṇavandanā",
  "mp2:1.1": "Buddhaguṇavandanā",
  "mp2:2.1": "Iti pi so Bhagavā Arahaṁ Sammāsambuddho,",
  "mp2:2.2": "vijjācaraṇasampanno Sugato lokavidū,",
  "mp2:2.3": "anuttaro purisadammasārathī,",
  "mp2:2.4": "Satthā devamanussānaṁ Buddho Bhagavā ti.",
  "mp2:3.1": "Dhammaguṇavandanā",
  "mp2:4.1": "Svākkhāto Bhagavatā Dhammo, sandiṭṭhiko, akāliko,",
  "mp2:4.2": "ehipassiko, opanayiko, paccattaṁ veditabbo viññūhī ti.",
  "mp2:5.1": "Saṅghaguṇavandanā",
  "mp2:6.1": "Supaṭipanno Bhagavato sāvakasaṅgho,",
  "mp2:6.2": "ujupaṭipanno Bhagavato sāvakasaṅgho,",
  "mp2:6.3": "ñāyapaṭipanno Bhagavato sāvakasaṅgho,",
  "mp2:6.4": "sāmīcipaṭipanno Bhagavato sāvakasaṅgho,",
  "mp2:6.5": "yad-idaṁ cattāri purisayugāni aṭṭha purisapuggalā,",
  "mp2:6.6": "esa Bhagavato sāvakasaṅgho,",
  "mp2:6.7": "āhuneyyo, pāhuneyyo, dakkhiṇeyyo, añjalikaranīyo,",
  "mp2:6.8": "anuttaraṁ puññakkhettaṁ lokassā ti.",
  "mp2:7.1": "",
  "mp2:8.1": "Etena saccavajjena pātu tvaṁ ratanattayaṁ!",
  "mp2:9.1": "Etena saccavajjena pātu tvaṁ ratanattayaṁ!",
  "mp2:10.1": "Etena saccavajjena pātu tvaṁ ratanattayaṁ!"
}