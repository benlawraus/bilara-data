{
  "up5:0.1": "5. Aṭṭhavīsatiparittaṁ",
  "up5:1.1": "Taṇhaṅkaro mahāvīro, Medhaṅkaro mahāyaso,",
  "up5:1.2": "Saraṇaṅkaro lokahito, Dīpaṅkaro jutindharo,",
  "up5:2.1": "Koṇḍañño janapāmokkho, Maṅgalo purisāsabho,",
  "up5:2.2": "Sumano sumano dhīro, Revato rativaddhano,",
  "up5:3.1": "Sobhito guṇasampanno, Anomadassī januttamo,",
  "up5:3.2": "Padumo lokapajjoto, Nārado varasārathī,",
  "up5:4.1": "Padumuttaro sattasāro, Sumedho aggapuggalo,",
  "up5:4.2": "Sujāto sabbalokaggo, Piyadassī narāsabho,",
  "up5:5.1": "Atthadassī kāruṇiko, Dhammadassī tamonudo,",
  "up5:5.2": "Siddhattho asamo loke, Tisso varadasaṁvaro,",
  "up5:6.1": "Phusso varadasambuddho, Vipassī ca anūpamo,",
  "up5:6.2": "Sikhī sabbahito Satthā, Vessabhū sukhadāyako,",
  "up5:7.1": "Kakusandho satthavāho, Koṇāgamano raṇañjaho,",
  "up5:7.2": "Kassapo sirisampanno, Gotamo Sakyapuṅgavo.",
  "up5:8.1": "Tesaṁ saccena sīlena, khantimettabalena ca,",
  "up5:8.2": "te pi tvaṁ anurakkhantu ārogyena sukhena cā! ti"
}