{
  "up1:0.1": "Upagantho",
  "up1:0.2": "1. Jayamaṅgalagāthā",
  "up1:1.1": "Bāhuṁ sahassam-abhinimmitasāyudhaṁ taṁ,",
  "up1:1.2": "Girimekhalaṁ uditaghorasasenamāraṁ,",
  "up1:1.3": "dānādidhammavidhinā jitavā munindo -",
  "up1:1.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:2.1": "Mārātirekam-abhiyujjhita sabbarattiṁ,",
  "up1:2.2": "ghoraṁ pan’ Ālavakam-akkhamathaddhayakkhaṁ,",
  "up1:2.3": "khantīsudantavidhinā jitavā munindo -",
  "up1:2.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:3.1": "Nālāgiriṁ gajavaraṁ atimattabhūtaṁ,",
  "up1:3.2": "dāvaggicakkam-asanīva sudāruṇaṁ taṁ,",
  "up1:3.3": "mettambusekavidhinā jitavā munindo -",
  "up1:3.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:4.1": "Ukkhittakhaggam-atihatthasudāruṇaṁ taṁ",
  "up1:4.2": "dhāvaṁ tiyojanapathaṅgulimālavantaṁ:",
  "up1:4.3": "iddhībhisaṅkhatamano jitavā munindo -",
  "up1:4.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:5.1": "Katvāna kaṭṭham-udaraṁ iva gabbhinīyā,",
  "up1:5.2": "Ciñcāya duṭṭhavacanaṁ janakāyamajjhe:",
  "up1:5.3": "santena somavidhinā jitavā munindo -",
  "up1:5.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:6.1": "Saccaṁ vihāya mati-Saccakavādaketuṁ,",
  "up1:6.2": "vādābhiropitamanaṁ ati-andhabhūtaṁ,",
  "up1:6.3": "paññāpadīpajalito jitavā munindo -",
  "up1:6.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:7.1": "Nandopanandabhujagaṁ vibudhaṁ mahiddhiṁ,",
  "up1:7.2": "puttena therabhujagena damāpayanto,",
  "up1:7.3": "iddhūpadesavidhinā jitavā munindo -",
  "up1:7.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:8.1": "Duggāhadiṭṭhibhujagena sudaṭṭhahatthaṁ,",
  "up1:8.2": "brahmaṁ visuddhijutim-iddhi-Bakābhidhānaṁ,",
  "up1:8.3": "ñāṇāgadena vidhinā jitavā munindo -",
  "up1:8.4": "taṁ tejasā bhavatu te jayamaṅgalāni!",
  "up1:9.1": "Etā pi Buddhajayamaṅgala-aṭṭhagāthā,",
  "up1:9.2": "yo vācako dinadine sarate-m-atandī,",
  "up1:9.3": "hitvānanekavividhāni cupaddavāni,",
  "up1:9.4": "mokkhaṁ sukhaṁ adhigameyya naro sapañño."
}