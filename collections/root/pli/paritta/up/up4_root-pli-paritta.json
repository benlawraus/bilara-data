{
  "up4:0.1": "4. Jinapañjaraṁ",
  "up4:1.1": "Jayāsanagatā vīrā, jetvā Māraṁ savāhiniṁ,",
  "up4:1.2": "catusaccāmatarasaṁ ye piviṁsu narāsabhā.",
  "up4:2.1": "Taṇhaṅkarādayo Buddhā aṭṭhavīsatināyakā,",
  "up4:2.2": "sabbe patiṭṭhitā tuyhaṁ matthake te munissarā.",
  "up4:3.1": "Sire patiṭṭhitā Buddhā, Dhammo ca tava locane,",
  "up4:3.2": "Saṅgho patiṭṭhito tuyhaṁ ure sabbaguṇākaro,",
  "up4:4.1": "Hadaye Anuruddho ca, Sāriputto ca dakkhiṇe,",
  "up4:4.2": "Koṇḍañño piṭṭhibhāgasmiṁ, Moggallānosi vāmake.",
  "up4:5.1": "Dakkhiṇe savaṇe tuyhaṁ, āhuṁ Ānandarāhulā,",
  "up4:5.2": "Kassapo ca Mahānāmo, ubhosuṁ vāmasotake.",
  "up4:6.1": "Kesante piṭṭhibhāgasmiṁ suriyo viya pabhaṅkaro -",
  "up4:6.2": "nisinno sirisampanno Sobhito munipuṅgavo.",
  "up4:7.1": "Kumārakassapo nāma, mahesī citravādako,",
  "up4:7.2": "so tuyhaṁ vadane niccaṁ, patiṭṭhāsi guṇākaro.",
  "up4:8.1": "Puṇṇo Aṅgulimālo ca, Upāli Nandasīvalī -",
  "up4:8.2": "therā pañca ime jātā lalāṭe tilakā tava.",
  "up4:9.1": "Sesāsīti mahātherā, vijitā jinasāvakā,",
  "up4:9.2": "jalantā sīlatejena, aṅga-m-aṅgesu saṇṭhitā.",
  "up4:10.1": "“Ratanaṁ” purato āsi, dakkhiṇe “Mettasuttakaṁ”,",
  "up4:10.2": "“Dhajaggaṁ” pacchato āsi, vāme “Aṅgulimālakaṁ”,",
  "up4:11.1": "“Khandhamoraparittañ”-ca, “Āṭānāṭiyasuttakaṁ”,",
  "up4:11.2": "ākāsacchadanaṁ āsi, sesā pākārasaññitā.",
  "up4:12.1": "Jināṇābalasaṁyutte, Dhammapākāralaṅkate,",
  "up4:12.2": "vasato te catukiccena, sadā Sambuddhapañjare,",
  "up4:13.1": "vātapittādisañjātā bāhirajjhattupaddavā,",
  "up4:13.2": "asesā vilayaṁ yantu anantaguṇatejasā.",
  "up4:14.1": "Jinapañjaramajjhaṭṭhaṁ viharantaṁ mahītale,",
  "up4:14.2": "sadā pālentu tvaṁ sabbe te mahāpurisāsabhā.",
  "up4:15.1": "Iccevam-accantakato surakkho, jinānubhāvena jitūpapaddavo,",
  "up4:15.2": "Buddhānubhāvena hatārisaṅgho, carāhi saddhammanubhāvapālito!",
  "up4:16.1": "Iccevam-accantakato surakkho, jinānubhāvena jitūpapaddavo,",
  "up4:16.2": "Dhammānubhāvena hatārisaṅgho, carāhi saddhammanubhāvapālito!",
  "up4:17.1": "Iccevam-accantakato surakkho, jinānubhāvena jitūpapaddavo,",
  "up4:17.2": "Saṅghānubhāvena hatārisaṅgho, carāhi saddhammanubhāvapālito!",
  "up4:18.1": "Saddhammapākāraparikkhitosi, aṭṭhāriyā aṭṭhadisāsu honti,",
  "up4:18.2": "etthantare aṭṭhanāthā bhavanti, uddhaṁ vitānaṁ va jinā ṭhitā te.",
  "up4:19.1": "Bhindanto Mārasenaṁ, tava sirasi ṭhito, Bodhim-āruyha Satthā.",
  "up4:19.2": "Moggallānosi vāme vasati bhujataṭe, dakkhiṇe Sāriputto.",
  "up4:19.3": "Dhammo majjhe urasmiṁ viharati bhavato mokkhato morayoniṁ,",
  "up4:19.4": "sampatto Bodhisatto caraṇayugagato, bhānu lokekanātho.",
  "up4:20.1": "Sabbāvamaṅgalam-upaddavadunnimittaṁ,",
  "up4:20.2": "sabbītirogagahadosa-m-asesanindā,",
  "up4:20.3": "sabbantarāyabhayadussupinaṁ akantaṁ -",
  "up4:20.4": "Buddhānubhāvapavarena payātu nāsaṁ!",
  "up4:21.1": "Sabbāvamaṅgalam-upaddavadunnimittaṁ,",
  "up4:21.2": "sabbītirogagahadosa-m-asesanindā,",
  "up4:21.3": "sabbantarāyabhayadussupinaṁ akantaṁ -",
  "up4:21.4": "Dhammānubhāvapavarena payātu nāsaṁ!",
  "up4:22.1": "Sabbāvamaṅgalam-upaddavadunnimittaṁ,",
  "up4:22.2": "sabbītirogagahadosa-m-asesanindā,",
  "up4:22.3": "sabbantarāyabhayadussupinaṁ akantaṁ -",
  "up4:22.4": "Saṅghānubhāvapavarena payātu nāsaṁ!"
}