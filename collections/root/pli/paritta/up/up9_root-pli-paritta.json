{
  "up9:0.1": "9. Bojjhaṅgaparittaṁ",
  "up9:1.1": "",
  "up9:2.1": "Saṁsāre saṁsarantānaṁ sabbadukkhavināsane",
  "up9:2.2": "Sattadhamme ca Bojjhaṅge Mārasenapamaddane.",
  "up9:3.1": "Bujjhitvā ye cime sattā tibhavā muttakuttamā,",
  "up9:3.2": "Ajātim-ajarābyādhim amataṁ nibbhayaṁ gatā.",
  "up9:4.1": "Evam-ādiguṇūpetaṁ anekaguṇasaṅgahaṁ",
  "up9:4.2": "Osadhañ-ca imaṁ mantaṁ: Bojjhaṅgañ-ca bhaṇāmahe.",
  "up9:5.1": "",
  "up9:6.1": "Bojjhaṅgo satisaṅkhāto dhammānaṁ vicayo tathā,",
  "up9:6.2": "Vīriyaṁ pīti-passaddhi Bojjhaṅgā ca tathāpare,",
  "up9:6.3": "Samādhupekkhabojjhaṅgā: satte te Sabbadassinā",
  "up9:6.4": "Muninā sammad-akkhātā, bhāvitā bahulīkatā",
  "up9:6.5": "Saṁvattanti abhiññāya Nibbānāya ca Bodhiyā:",
  "up9:7.1": "Etena saccavajjena sotthi te hotu sabbadā!",
  "up9:8.1": "Ekasmiṁ samaye Nātho Moggallānañ-ca Kassapaṁ",
  "up9:8.2": "Gilāne dukkhite disvā, Bojjhaṅge satta desayi,",
  "up9:8.3": "Te ca taṁ abhinanditvā rogā mucciṁsu taṅkhane:",
  "up9:9.1": "Etena saccavajjena sotthi te hotu sabbadā!",
  "up9:10.1": "Ekadā Dhammarājā pi gelaññenābhipīḷito,",
  "up9:10.2": "Cundattherena taṁ yeva bhaṇāpetvāna sādaraṁ,",
  "up9:10.3": "Sammoditvāna ābādhā tamhā vuṭṭhāsi ṭhānaso:",
  "up9:11.1": "Etena saccavajjena sotthi te hotu sabbadā!",
  "up9:12.1": "Pahinā te ca ābādhā tiṇṇannam-pi Mahesinaṁ",
  "up9:12.2": "Maggahatākilesā va pattānupattidhammataṁ:",
  "up9:13.1": "Etena saccavajjena sotthi te hotu sabbadā!"
}