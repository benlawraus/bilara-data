{
  "cbv15:0.1": "15. Suriyaparittaṁ",
  "cbv15:1.1": "",
  "cbv15:2.1": "Suriyo Rāhugahito, mutto yassānubhāvato,",
  "cbv15:2.2": "sabbaveribhayaṁ nāsaṁ parittaṁ taṁ bhaṇāmahe.",
  "cbv15:3.1": "",
  "cbv15:4.1": "Evaṁ me sutaṁ:",
  "cbv15:5.1": "ekaṁ samayaṁ Bhagavā Sāvatthiyaṁ viharati",
  "cbv15:5.2": "Jetavane Anāthapiṇḍikassa ārāme.",
  "cbv15:6.1": "REFERENCE sn2.10:1.2 TO sn2.10:8.4"
}