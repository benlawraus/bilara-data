{
  "cbv6:0.1": "6. Dasadhammasuttaṁ",
  "cbv6:1.1": "",
  "cbv6:2.1": "Bhikkhūnaṁ guṇasaṁyuttaṁ yaṁ desesi Mahāmuni,",
  "cbv6:3.1": "yaṁ sutvā paṭipajjanto, sabbadukkhā pamuccati.",
  "cbv6:4.1": "Sabbalokahitatthāya parittaṁ taṁ bhaṇāmahe.",
  "cbv6:5.1": "",
  "cbv6:6.1": "Evaṁ me sutaṁ:",
  "cbv6:7.1": "ekaṁ samayaṁ Bhagavā Sāvatthiyaṁ viharati",
  "cbv6:8.1": "Jetavane Anāthapiṇḍikassa ārāme.",
  "cbv6:9.1": "Tatra kho Bhagavā bhikkhū āmantesi:",
  "cbv6:10.1": "“Bhikkhavo!” ti, “Bhadante!” ti te bhikkhū Bhagavato paccassosuṁ,",
  "cbv6:11.1": "Bhagavā etad-avoca:",
  "cbv6:12.1": "REFERENCE an10.48:1.1 TO an10.48:13.1",
  "cbv6:25.1": "Idam-avoca Bhagavā,",
  "cbv6:25.2": "attamanā te bhikkhū Bhagavato bhāsitaṁ abhinandun-ti."
}
