{
  "cbv10:0.1": "10. Khandhaparittaṁ",
  "cbv10:1.1": "",
  "cbv10:2.1": "Sabbāsivisajātīnaṁ dibbamantāgadaṁ viya,",
  "cbv10:2.2": "yaṁ nāsesi visaṁ ghoraṁ sesaṁ cāpi parissayaṁ.",
  "cbv10:2.3": "Āṇakkhettamhi sabbattha, sabbadā sabbapāṇinaṁ,",
  "cbv10:2.4": "sabbaso pi vināseti, parittaṁ taṁ bhaṇāmahe.",
  "cbv10:3.1": "",
  "cbv10:4.1": "Evaṁ me sutaṁ:",
  "cbv10:5.1": "REFERENCE an4.67:1.1 TO an4.67:10.6"
}