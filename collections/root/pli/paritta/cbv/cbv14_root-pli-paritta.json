{
  "cbv14:0.1": "14. Candaparittaṁ",
  "cbv14:1.1": "",
  "cbv14:2.1": "Rāhunā gahito Cando, mutto yassānubhāvato,",
  "cbv14:2.2": "sabbaveribhayaṁ nāsaṁ parittaṁ taṁ bhaṇāmahe.",
  "cbv14:3.1": "",
  "cbv14:4.1": "Evaṁ me sutaṁ:",
  "cbv14:5.1": "ekaṁ samayaṁ Bhagavā Sāvatthiyaṁ viharati",
  "cbv14:5.2": "Jetavane Anāthapiṇḍikassa ārāme.",
  "cbv14:6.1": "REFERENCE sn2.9:1.2 TO sn2.9:7.4"
}