{
  "cbv8:0.1": "8. Ratanasuttaṁ",
  "cbv8:1.1": "",
  "cbv8:2.1": "Koṭisatasahassesu cakkavāḷesu devatā",
  "cbv8:2.2": "yassāṇaṁ patigaṇhanti yañ-ca Vesāliyaṁ pure,",
  "cbv8:2.3": "rogāmanussadubbhikkha sambhūtaṁ tividhaṁ bhayaṁ -",
  "cbv8:2.4": "khippam-antaradhāpesi, parittaṁ taṁ bhaṇāmahe.",
  "cbv8:3.1": "",
  "cbv8:4.1": "REFERENCE snp2.1:1.1 TO snp2.1:18.4"
}
