{
  "cbv11:0.1": "11. Mettānisaṁsasuttaṁ",
  "cbv11:1.1": "",
  "cbv11:2.1": "Aggikkhandhopamaṁ sutvā jātasaṁvegabhikkhunaṁ",
  "cbv11:2.2": "assādatthāya desesi yaṁ parittaṁ Mahāmuni.",
  "cbv11:2.3": "Sabbalokahitatthāya parittaṁ tam bhaṇāmahe.",
  "cbv11:3.1": "",
  "cbv11:4.1": "Evaṁ me sutaṁ:",
  "cbv11:5.1": "ekaṁ samayaṁ Bhagavā Sāvatthiyaṁ viharati",
  "cbv11:5.2": "Jetavane Anāthapiṇḍikassa ārāme.",
  "cbv11:6.1": "Tatra kho Bhagavā bhikkhū āmantesi:",
  "cbv11:7.1": "“Bhikkhavo!” ti, “Bhadante!” ti te bhikkhū Bhagavato paccassosuṁ,",
  "cbv11:8.1": "Bhagavā etad-avoca:",
  "cbv11:9.1": "REFERENCE an11.15:1.1 TO an11.15:2.3",
  "cbv11:10.1": "Idam-avoca Bhagavā,",
  "cbv11:10.2": "attamanā te bhikkhū Bhagavato bhāsitaṁ abhinandun-ti."
}