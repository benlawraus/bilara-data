{
  "cbv16:0.1": "16. Dhajaggaparittaṁ",
  "cbv16:1.1": "",
  "cbv16:2.1": "Yassānussaraṇenāpi antalikkhe pi pāṇino",
  "cbv16:2.2": "patiṭṭham-adhigacchanti, bhūmiyaṁ viya sabbathā.",
  "cbv16:2.3": "Sabbūpaddavajālamhā yakkhacorārisambhavā,",
  "cbv16:2.4": "gaṇanā na ca muttānaṁ, parittaṁ taṁ bhaṇāmahe.",
  "cbv16:3.1": "",
  "cbv16:4.1": "Evaṁ me sutaṁ:",
  "cbv16:5.1": "ekaṁ samayaṁ Bhagavā Sāvatthiyaṁ viharati",
  "cbv16:5.2": "Jetavane Anāthapiṇḍikassa ārāme.",
  "cbv16:6.1": "REFERENCE sn11.3:1.2 TO sn11.3:16.4",
  "cbv16:7.1": "Paṭhamakabhāṇavāraṁ Niṭṭhitaṁ"
}