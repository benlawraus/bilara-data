{
  "cbv20:0.1": "20. Girimānandasuttaṁ",
  "cbv20:1.1": "",
  "cbv20:2.1": "Thero yaṁ Girimānando, Ānandattherasantikā",
  "cbv20:2.2": "sutvā tasmiṁ khaṇe yeva ahosi nirupaddavo.",
  "cbv20:2.3": "Dasasaññūpasaṁyuttaṁ, parittaṁ taṁ bhaṇāmahe.",
  "cbv20:3.1": "",
  "cbv20:4.1": "Evaṁ me sutaṁ:",
  "cbv20:5.1": "REFERENCE an10.60:1.1 TO an10.60:13.12",
  "cbv20:6.1": "abhippamodayaṁ cittaṁ assasissāmī ti sikkhati,",
  "cbv20:6.2": "abhippamodayaṁ cittaṁ passasissāmī ti sikkhati,",
  "cbv20:7.1": "samādahaṁ cittaṁ assasissāmī ti sikkhati,",
  "cbv20:7.2": "samādahaṁ cittaṁ passasissāmī ti sikkhati,",
  "cbv20:8.1": "vimocayaṁ cittaṁ assasissāmī ti sikkhati,",
  "cbv20:8.2": "vimocayaṁ cittaṁ passasissāmī ti sikkhati.",
  "cbv20:9.1": "aniccānupassī assasissāmī ti sikkhati,",
  "cbv20:9.2": "aniccānupassī passasissāmī ti sikkhati,",
  "cbv20:10.1": "virāgānupassī assasissāmī ti sikkhati,",
  "cbv20:10.2": "virāgānupassī passasissāmī ti sikkhati,",
  "cbv20:11.1": "nirodhānupassī assasissāmī ti sikkhati,",
  "cbv20:11.2": "nirodhānupassī passasissāmī ti sikkhati,",
  "cbv20:12.1": "REFERENCE an10.60:13.19 TO an10.60:15.3"
}