{
  "cbv22:0.1": "Atirekāni Sattasuttāni",
  "cbv22:0.2": "22. Dhammacakkappavattanasuttaṁ",
  "cbv22:1.1": "Namo tassa Bhagavato Arahato Sammāsambuddhassa x 3",
  "cbv22:2.1": "Evaṁ me sutaṁ:",
  "cbv22:3.1": "REFERENCE sn56.11:1.1 TO sn56.11:1.2",
  "cbv22:4.1": "REFERENCE sn56.11:2.1 TO sn56.11:3.4",
  "cbv22:5.1": "",
  "cbv22:6.1": "REFERENCE sn56.11:4.1 TO sn56.11:4.9",
  "cbv22:7.1": "sammādiṭṭhi",
  "cbv22:7.2": "sammāsaṅkappo",
  "cbv22:7.3": "sammāvācā",
  "cbv22:7.4": "sammākammanto",
  "cbv22:7.5": "sammā-ājīvo",
  "cbv22:7.6": "sammāvāyāmo",
  "cbv22:7.7": "sammāsati",
  "cbv22:7.8": "sammāsamādhi.",
  "cbv22:8.1": "",
  "cbv22:9.1": "REFERENCE sn56.11:5.1 TO sn56.11:5.1",
  "cbv22:10.1": "Taṁ kho pan’ “idaṁ dukkhaṁ ariyasaccaṁ” pariññeyyan-ti -",
  "cbv22:10.2": "me bhikkhave pubbe ananussutesu dhammesu",
  "cbv22:10.3": "cakkhuṁ udapādi, ñāṇaṁ udapādi, paññā udapādi,",
  "cbv22:10.4": "vijjā udapādi, āloko udapādi.",
  "cbv22:11.1": "REFERENCE sn56.11:5.3 TO sn56.11:6.1",
  "cbv22:12.1": "Taṁ kho pan’ “idaṁ dukkhasamudayaṁ ariyasaccaṁ” pahātabban-ti -",
  "cbv22:12.2": "me bhikkhave pubbe ananussutesu dhammesu",
  "cbv22:12.3": "cakkhuṁ udapādi, ñāṇaṁ udapādi, paññā udapādi,",
  "cbv22:12.4": "vijjā udapādi, āloko udapādi.",
  "cbv22:13.1": "REFERENCE sn56.11:6.3 TO sn56.11:7.1",
  "cbv22:14.1": "Taṁ kho pan’ “idaṁ dukkhanirodhaṁ ariyasaccaṁ” sacchikātabban-ti -",
  "cbv22:14.2": "me bhikkhave pubbe ananussutesu dhammesu",
  "cbv22:14.3": "cakkhuṁ udapādi, ñāṇaṁ udapādi, paññā udapādi,",
  "cbv22:14.4": "vijjā udapādi, āloko udapādi.",
  "cbv22:15.1": "REFERENCE sn56.11:7.3 TO sn56.11:8.1",
  "cbv22:16.1": "Taṁ kho pan’ “idaṁ dukkhanirodhagāminī paṭipadā ariyasaccaṁ”",
  "cbv22:16.2": "bhāvetabban-ti -",
  "cbv22:16.3": "me bhikkhave pubbe ananussutesu dhammesu",
  "cbv22:16.4": "cakkhuṁ udapādi, ñāṇaṁ udapādi, paññā udapādi,",
  "cbv22:16.5": "vijjā udapādi, āloko udapādi.",
  "cbv22:17.1": "REFERENCE sn56.11:8.3 TO sn56.11:8.3",
  "cbv22:18.1": "",
  "cbv22:19.1": "REFERENCE sn56.11:9.1 TO sn56.11:10.3",
  "cbv22:20.1": "",
  "cbv22:21.1": "REFERENCE sn56.11:10.4 TO sn56.11:11.2",
  "cbv22:22.1": "",
  "cbv22:23.1": "REFERENCE sn56.11:12.1 TO sn56.11:12.2",
  "cbv22:24.1": "REFERENCE sn56.11:12.3 TO sn56.11:12.4",
  "cbv22:25.1": "Cātummahārājikānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:25.2": "Tāvatiṁsā devā saddam-anussāvesuṁ:",
  "cbv22:26.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:26.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:26.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:26.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:27.1": "Tāvatiṁsānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:27.2": "Yāmā devā saddam-anussāvesuṁ:",
  "cbv22:28.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:28.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:28.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:28.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:29.1": "Yāmānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:29.2": "Tusitā devā saddam-anussāvesuṁ:",
  "cbv22:30.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:30.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:30.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:30.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:31.1": "Tusitānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:31.2": "Nimmāṇaratī devā saddam-anussāvesuṁ:",
  "cbv22:32.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:32.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:32.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:32.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:33.1": "Nimmāṇaratīnaṁ devānaṁ saddaṁ sutvā",
  "cbv22:33.2": "Paranimmitavasavattino devā saddam-anussāvesuṁ:",
  "cbv22:34.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:34.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:34.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:34.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:35.1": "",
  "cbv22:36.1": "Paranimmitavasavattīnaṁ devānaṁ saddaṁ sutvā",
  "cbv22:36.2": "Brahmapārisajjā devā saddam-anussāvesuṁ:",
  "cbv22:37.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:37.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:37.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:37.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:38.1": "Brahmapārisajjānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:38.2": "Brahmapurohitā devā saddam-anussāvesuṁ:",
  "cbv22:39.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:39.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:39.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:39.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:40.1": "Brahmapurohitānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:40.2": "Mahābrahmā devā saddam-anussāvesuṁ:",
  "cbv22:41.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:41.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:41.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:41.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:42.1": "Mahābrahmānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:42.2": "Parittābhā devā saddam-anussāvesuṁ:",
  "cbv22:43.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:43.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:43.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:43.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:44.1": "Parittābhānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:44.2": "Appamāṇābhā devā saddam-anussāvesuṁ:",
  "cbv22:45.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:45.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:45.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:45.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:46.1": "Appamāṇābhānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:46.2": "Ābhassarā devā saddam-anussāvesuṁ:",
  "cbv22:47.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:47.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:47.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:47.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:48.1": "Ābhassarānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:48.2": "Parittasubhā devā saddam-anussāvesuṁ:",
  "cbv22:49.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:49.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:49.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:49.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:50.1": "Parittasubhānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:50.2": "Appamāṇasubhā devā saddam-anussāvesuṁ:",
  "cbv22:51.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:51.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:51.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:51.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:52.1": "Appamāṇasubhānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:52.2": "Subhakiṇhakā devā saddam-anussāvesuṁ:",
  "cbv22:53.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:53.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:53.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:53.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:54.1": "Subhakiṇhakānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:54.2": "Vehapphalā devā saddam-anussāvesuṁ:",
  "cbv22:55.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:55.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:55.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:55.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:56.1": "",
  "cbv22:57.1": "Vehapphalānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:57.2": "Avihā devā saddam-anussāvesuṁ:",
  "cbv22:58.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:58.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:58.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:58.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:59.1": "Avihānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:59.2": "Atappā devā saddam-anussāvesuṁ:",
  "cbv22:60.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:60.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:60.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:60.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:61.1": "Atappānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:61.2": "Sudassā devā saddam-anussāvesuṁ:",
  "cbv22:62.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:62.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:62.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:62.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:63.1": "Sudassānaṁ devānaṁ saddaṁ sutvā",
  "cbv22:63.2": "Sudassī devā saddam-anussāvesuṁ:",
  "cbv22:64.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:64.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:64.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:64.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:65.1": "Sudassīnaṁ devānaṁ saddaṁ sutvā",
  "cbv22:65.2": "Akaniṭṭhakā devā saddam-anussāvesuṁ:",
  "cbv22:66.1": "“Etaṁ Bhagavatā Bārāṇasiyaṁ Isipatane Migadāye,",
  "cbv22:66.2": "anuttaraṁ Dhammacakkaṁ pavattitaṁ,",
  "cbv22:66.3": "appativattiyaṁ samaṇena vā brāhmaṇena vā",
  "cbv22:66.4": "devena vā mārena vā brahmunā vā kenaci vā lokasmin”-ti.",
  "cbv22:67.1": "REFERENCE sn56.11:13.1 TO sn56.11:14.3"
}