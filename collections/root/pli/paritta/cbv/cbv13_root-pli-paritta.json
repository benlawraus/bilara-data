{
  "cbv13:0.1": "13. Moraparittaṁ",
  "cbv13:1.1": "",
  "cbv13:2.1": "Pūrento Bodhisambhāre nibbatto morayoninaṁ.",
  "cbv13:2.2": "Yena saṁvihitārakkhaṁ Mahāsattaṁ vane carā",
  "cbv13:2.3": "cirassaṁ vāyamantā pi, neva sakkhiṁsu gaṇhituṁ.",
  "cbv13:2.4": "“Brahmamantan”-ti akkhātaṁ, parittaṁ taṁ bhaṇāmahe.",
  "cbv13:3.1": "",
  "cbv13:4.1": "REFERENCE ja159:1.1 TO ja159:4.6"
}