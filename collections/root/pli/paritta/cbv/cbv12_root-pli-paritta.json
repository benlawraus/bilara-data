{
  "cbv12:0.1": "12. Mittānisaṁsaṁ",
  "cbv12:1.1": "",
  "cbv12:2.1": "Pūrento Bodhisambhāre Nātho Temiyajātiyaṁ",
  "cbv12:2.2": "mittānisaṁsaṁ yaṁ āha Sunandaṁ nāma sārathiṁ.",
  "cbv12:2.3": "Sabbalokahitatthāya parittaṁ taṁ bhaṇāmahe.",
  "cbv12:3.1": "",
  "cbv12:4.1": "REFERENCE ja538:12.1 TO ja538:21.4"
}