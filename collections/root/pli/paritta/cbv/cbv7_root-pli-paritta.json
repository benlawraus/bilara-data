{
  "cbv7:0.1": "7. Mahāmaṅgalasuttaṁ",
  "cbv7:1.1": "",
  "cbv7:2.1": "Yaṁ maṅgalaṁ dvādasasu cintayiṁsu sadevakā,",
  "cbv7:3.1": "sotthānaṁ nādhigacchanti; aṭṭhatiṁsañ-ca maṅgalaṁ",
  "cbv7:4.1": "desitaṁ devadevena sabbapāpavināsanaṁ.",
  "cbv7:5.1": "Sabbalokahitatthāya parittaṁ taṁ bhaṇāmahe.",
  "cbv7:6.1": "",
  "cbv7:7.1": "REFERENCE snp2.4:1.1 TO snp2.4:13.5"
}
