{
  "cbv9:0.1": "9. Karaṇīyamettasuttaṁ",
  "cbv9:1.1": "",
  "cbv9:2.1": "Yassānubhāvato yakkhā neva dassenti bhiṁsanaṁ,",
  "cbv9:2.2": "yamhi ve cānuyuñjanto rattiṁ divam-antandito",
  "cbv9:2.3": "sukhaṁ supati sutto ca pāpaṁ kiñci na passati -",
  "cbv9:2.4": "evam-ādiguṇopetaṁ, parittaṁ taṁ bhaṇāmahe.",
  "cbv9:3.1": "",
  "cbv9:4.1": "REFERENCE snp1.8:1.1 TO snp1.8:10.4"
}
