{
  "dhpak1.1:0.1": "Dhammapada-aṭṭhakathā",
  "dhpak1.1:0.2": "Ganthārambhakathā",
  "dhpak1.1:0.3": "Namo tassa bhagavato arahato sammāsambuddhassa",
  "dhpak1.1:1.1": "Mahāmohatamonaddhe, loke lokantadassinā;",
  "dhpak1.1:1.2": "Yena saddhammapajjoto, jālito jalitiddhinā.",
  "dhpak1.1:2.1": "Tassa pāde namassitvā, sambuddhassa sirīmato;",
  "dhpak1.1:2.2": "Saddhammañcassa pūjetvā, katvā saṅghassa cañjaliṃ.",
  "dhpak1.1:3.1": "Taṃ taṃ kāraṇamāgamma, dhammādhammesu kovido;",
  "dhpak1.1:3.2": "Sampattasaddhammapado, satthā dhammapadaṃ subhaṃ.",
  "dhpak1.1:4.1": "Desesi karuṇāvegasamussāhitamānaso;",
  "dhpak1.1:4.2": "Yaṃ ve devamanussānaṃ, pītipāmojjavaḍḍhanaṃ.",
  "dhpak1.1:5.1": "Paramparābhatā tassa, nipuṇā atthavaṇṇanā;",
  "dhpak1.1:5.2": "Yā tambapaṇṇidīpamhi, dīpabhāsāya saṇṭhitā.",
  "dhpak1.1:6.1": "Na sādhayati sesānaṃ, sattānaṃ hitasampadaṃ;",
  "dhpak1.1:6.2": "Appeva nāma sādheyya, sabbalokassa sā hitaṃ.",
  "dhpak1.1:7.1": "Iti āsīsamānena, dantena samacārinā;",
  "dhpak1.1:7.2": "Kumārakassapenāhaṃ, therena thiracetasā.",
  "dhpak1.1:8.1": "Saddhammaṭṭhitikāmena, sakkaccaṃ abhiyācito;",
  "dhpak1.1:8.2": "Taṃ bhāsaṃ ativitthāragatañca vacanakkamaṃ.",
  "dhpak1.1:9.1": "Pahāyāropayitvāna, tantibhāsaṃ manoramaṃ;",
  "dhpak1.1:9.2": "Gāthānaṃ byañjanapadaṃ, yaṃ tattha na vibhāvitaṃ.",
  "dhpak1.1:10.1": "Kevalaṃ taṃ vibhāvetvā, sesaṃ tameva atthato;",
  "dhpak1.1:10.2": "Bhāsantarena bhāsissaṃ, āvahanto vibhāvinaṃ;",
  "dhpak1.1:10.3": "Manaso pītipāmojjaṃ, atthadhammūpanissitaṃ."
}
